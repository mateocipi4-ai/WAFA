-- LOCK TOGGLE
lockBtn.MouseButton1Click:Connect(function()
	lockedUI = not lockedUI
	frame.Draggable = not lockedUI
	mini.Draggable = not lockedUI
	lockBtn.Text = lockedUI and "🔒" or "🔓"
end)

-- CLOSE / OPEN
closeBtn.MouseButton1Click:Connect(function()
	frame.Visible = false
	mini.Visible = true
end)

openBtn.MouseButton1Click:Connect(function()
	mini.Visible = false
	frame.Visible = true
end)

-- ANIMATION LOGIC
local function disableAnimations()
	lockedTracks = {}
	for _, track in ipairs(humanoid:GetPlayingAnimationTracks()) do
		track:Stop()
		table.insert(lockedTracks, track)
	end
end

local function enableAnimations()
	for _, track in ipairs(lockedTracks) do
		if track.Parent then track:Play() end
	end
	lockedTracks = {}
end

toggle.MouseButton1Click:Connect(function()
	enabled = not enabled
	if enabled then
		toggle.Text = "Animation: ON"
		toggle.BackgroundColor3 = Color3.fromRGB(0,150,0)
		disableAnimations()
	else
		toggle.Text = "Animation: OFF"
		toggle.BackgroundColor3 = Color3.fromRGB(120,0,0)
		enableAnimations()
	end
end)

RunService.Heartbeat:Connect(function()
	if enabled then
		for _, track in ipairs(humanoid:GetPlayingAnimationTracks()) do
			if not table.find(lockedTracks, track) then
				track:Stop()
				table.insert(lockedTracks, track)
			end
		end
	end
end)

player.CharacterAdded:Connect(function(char)
	humanoid = char:WaitForChild("Humanoid")
	if enabled then disableAnimations() end
end)
